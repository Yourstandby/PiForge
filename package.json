{
  "name": "piforge",
  "version": "0.8.0",
  "description": "PiForge — multi-session desktop workbench for the Pi coding agent: built-in browser, terminal, Git panel and plan mode.",
  "license": "MIT",
  "author": "PiForge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourstandby/PiForge.git"
  },
  "homepage": "https://github.com/yourstandby/PiForge#readme",
  "bugs": {
    "url": "https://github.com/yourstandby/PiForge/issues"
  },
  "desktopName": "piforge",
  "main": "electron/dist/main.js",
  "bin": {
    "piforge": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "npm run build:agent-host && node scripts/dev.mjs",
    "build": "npm run build:standalone",
    "build:standalone": "next build && node scripts/ensure-standalone-next-runtimes.mjs && node scripts/ensure-standalone-pi-runtime.mjs && npm run build:agent-host && node scripts/ensure-standalone-agent-host.mjs && node scripts/ensure-standalone-macos-universal-runtimes.mjs && node scripts/dereference-standalone-symlinks.mjs && node scripts/smoke-standalone-server.mjs",
    "start": "next start -p 30141",
    "lint": "eslint .",
    "icons": "node scripts/build-brand-icons.mjs",
    "check:electron-deps": "node lib/electron-updater-runtime-deps.mjs --check",
    "check:sdk-imports": "node scripts/check-sdk-imports.mjs",
    "check:pi-updates": "node scripts/check-pi-updates.mjs",
    "dist": "npm run build:standalone && npm run build:electron && node scripts/check-app-icon.mjs && node scripts/build-installer.mjs && node scripts/smoke-packaged-standalone.mjs",
    "build:agent-host": "tsc -p agent-host/tsconfig.json",
    "smoke:agent-host": "node scripts/smoke-agent-host.mjs",
    "sync:wiki-pages": "node scripts/sync-github-pages-wiki.mjs",
    "test": "node --test --test-force-exit \"lib/**/*.test.ts\" \"agent-host/**/*.test.ts\" \"lib/**/*.test.mjs\" \"electron/**/*.test.ts\" \"app/**/*.test.ts\" \"app/api/sessions/[[]id]/routes.test.ts\" \"hooks/**/*.test.ts\" \"components/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"package.test.ts\" \"middleware.test.ts\"",
    "test:windows": "node --test --test-force-exit \"electron/**/*.test.ts\" \"agent-host/**/*.test.ts\" \"lib/file-paths.test.ts\" \"lib/path-policy.test.ts\" \"lib/session-lock.test.ts\" \"lib/session-path-cache.test.ts\" \"lib/file-browser.test.ts\" \"lib/git-worktree.test.ts\" \"app/api/sessions/[[]id]/routes.test.ts\" \"lib/electron-*.test.mjs\" \"lib/installer-script.test.mjs\" \"lib/electron-builder-config.test.mjs\" \"package.test.ts\"",
    "test:macos": "node --test --test-force-exit \"electron/**/*.test.ts\" \"agent-host/**/*.test.ts\" \"lib/file-paths.test.ts\" \"lib/path-policy.test.ts\" \"lib/session-lock.test.ts\" \"lib/session-path-cache.test.ts\" \"lib/file-browser.test.ts\" \"lib/git-worktree.test.ts\" \"app/api/sessions/[[]id]/routes.test.ts\" \"lib/electron-*.test.mjs\" \"lib/electron-builder-config.test.mjs\" \"scripts/ensure-standalone-macos-universal-runtimes.test.mjs\" \"package.test.ts\"",
    "release": "npm version patch --no-git-tag-version && npm run build:standalone && npm publish --access public",
    "build:electron": "tsc -p electron/tsconfig.json && npm run build:agent-host && node -e \"const fs=require('fs'); fs.copyFileSync('electron/startup.html', 'electron/dist/startup.html'); fs.copyFileSync('electron/startup.js', 'electron/dist/startup.js')\"",
    "dev:electron": "npm run build:electron && node scripts/run-electron.mjs",
    "pack": "npm run build:standalone && npm run build:electron && node scripts/check-app-icon.mjs && npx electron-builder --dir && node scripts/smoke-packaged-standalone.mjs",
    "pack:mac": "npm run build:standalone && npm run build:electron && node scripts/check-app-icon.mjs --mac && npx electron-builder --mac --universal --dir && node scripts/smoke-packaged-standalone.mjs",
    "dist:mac": "npm run build:standalone && npm run build:electron && node scripts/check-app-icon.mjs --mac && npx electron-builder --mac --universal --publish never && node scripts/smoke-packaged-standalone.mjs",
    "smoke:agent-isolation": "node scripts/smoke-agent-isolation.mjs",
    "smoke:extension-ui": "node scripts/smoke-extension-ui-bridge.mjs",
    "smoke:host-reconnect": "node scripts/smoke-host-reconnect.mjs"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@electron/packager": "^20.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.2",
    "@webgpu/types": "^0.1.72",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fs-extra": "^8.1.0",
    "katex": "0.18.2",
    "mermaid": "^11.17.2",
    "minimatch": "^10.2.5",
    "next": "16.3.8",
    "postcss": "^8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "allowScripts": {
    "electron@43.7.7": true
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
